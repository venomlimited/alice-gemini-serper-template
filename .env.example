# ── Обязательно ───────────────────────────────────────────────
GEMINI_API_KEY=

# ── Рекомендуется ─────────────────────────────────────────────
# Поиск в интернете (serper.dev). Без ключа навык отвечает без поиска.
SERPER_API_KEY=
# ID навыка из кабинета Яндекс Диалогов: чужие запросы получат 403.
ALICE_SKILL_ID=

# ── Местоположение ───────────────────────────────────────────
USER_NAME=Михаил
USER_CITY=Ташкент
USER_COUNTRY=Узбекистан
# Часовой пояс берётся из запроса Алисы. Раскомментируйте, если станция настроена на чужой пояс.
# USER_TIMEZONE=Asia/Tashkent
SEARCH_COUNTRY=uz
SEARCH_LANGUAGE=ru
# Необязательно: точная локация в формате Google (проверьте в плейграунде Serper).
# SEARCH_LOCATION=Tashkent,Tashkent,Uzbekistan

# ── Модель ────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-3.5-flash-lite
# auto | off | minimal | low | medium | high
# GEMINI_THINKING=auto

# ── Режим «ещё думаю» (необязательно) ────────────────────────
# Подключите Upstash Redis через Vercel Marketplace — переменные подставятся сами.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# auto (включён при наличии Redis) | off
# ASYNC_MODE=auto

# ── Тонкая настройка таймингов, мс ───────────────────────────
# RESPONSE_DEADLINE_MS=3300
# SERPER_TIMEOUT_MS=1200
# GEMINI_RESERVE_MS=1600
# BACKGROUND_TIMEOUT_MS=20000
